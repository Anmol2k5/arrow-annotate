# Arrow Annotate — example configuration
# Copy to `.env` in the project root (git-ignored) and adjust as needed.
# Real environment variables always override values from `.env`.

# Data/config home: token, config.json, logs.
# Default: ~/.arrow
ARROW_HOME=

# Local HTTP API. Loopback-only by default; a non-loopback host is rejected
# unless ARROW_ALLOW_NON_LOOPBACK=1 is also set.
ARROW_HTTP_HOST=127.0.0.1
ARROW_HTTP_PORT=5001

# Local WebSocket bridge used by the browser extension.
# If you change this port, enter the same ws:// URL in the extension popup's
# "Bridge URL" field (only loopback addresses are accepted).
ARROW_WS_HOST=127.0.0.1
ARROW_WS_PORT=5002

# Agentation service endpoint (optional integration).
ARROW_AGENTATION_URL=http://127.0.0.1:4747

# Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG
ARROW_LOG_LEVEL=INFO

# Opt-in capabilities (comma-separated). Read capabilities are on by default;
# mutating ones are off until listed here.
# e.g. ARROW_ENABLED_CAPABILITIES=control_native,run_provider
ARROW_ENABLED_CAPABILITIES=

# Voice transcription backend: google (network; sends audio to Google) or
# off (disables cloud transcription). See README privacy section.
ARROW_VOICE_TRANSCRIPTION=google

# Deliberately expose the local server beyond loopback. Leave unset.
# ARROW_ALLOW_NON_LOOPBACK=1
