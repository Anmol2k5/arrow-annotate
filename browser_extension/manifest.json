{
  "manifest_version": 3,
  "name": "Bluely Web Bridge",
  "version": "1.1.0",
  "description": "Connects Bluely desktop pointer to web pages for deep element inspection",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bluely Web Bridge",
    "default_popup": "popup.html"
  }
}
