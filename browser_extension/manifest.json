{
  "manifest_version": 3,
  "name": "Arrow Annotate Bridge",
  "version": "1.2.0",
  "description": "Connects the Arrow Annotate desktop app to web pages for element inspection",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Arrow Annotate Bridge",
    "default_popup": "popup.html"
  }
}
